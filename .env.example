# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# Random string that signs session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app (GitHub > Settings > Developer settings > OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/callback/github (and your production URL).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The ONLY GitHub account allowed into /admin, by numeric account id (not login name).
# Find yours at https://api.github.com/users/YOUR-LOGIN  (the "id" field).
ADMIN_GITHUB_ID=

# MongoDB Atlas connection string. It includes the database username and password, so keep it
# here only. URL-encode special characters in the password (@ : / ? # become %40 %3A %2F %3F %23).
# Without it the app falls back to a local JSON file (development only; required on Vercel).
MONGODB_URI=
# Database name (default: blog).
MONGODB_DB=blog
# Optional, EMPTY database only: set to true once to load the placeholder sample content.
# MONGODB_SEED_SAMPLE=true

# Cloudinary, for image upload in the admin editor (Cloudinary dashboard > API keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder for uploads (default: blog).
# CLOUDINARY_FOLDER=

# Optional: where the local-file fallback store keeps content.json (default: ./.data).
# CONTENT_DATA_DIR=
